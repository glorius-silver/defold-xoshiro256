[bootstrap]
main_collection = /example/example.collectionc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = defold-xoshiro256

[library]
include_dirs = xoshiro256

[input]
game_binding = /builtins/input/all.input_bindingc

